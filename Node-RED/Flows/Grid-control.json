    {
        "id": "c444dd426742718d",
        "type": "function",
        "z": "ee316a5134bafa11",
        "name": "Sync flow.GridRelayState",
        "func": "const v = Number(msg.payload);\n// Victron relay: 0=open(off), 1=closed(on)\nconst isOn = (v === 1);\n\nflow.set('GridRelayState', isOn);\n// optional: also expose boolean downstream\nmsg.payload = isOn;\nreturn msg;",
