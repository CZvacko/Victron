    {
        "id": "45551dc1bee25689",
        "type": "function",
        "z": "ee316a5134bafa11",
        "name": "set payload",
        "func": "// Node-RED Function node\n// Stores inputs as flow variables (with defaults) and outputs only for expected topics.\n\nlet grid = flow.get('DiAllowOffgrid');\nlet soc  = flow.get('IsOffgridSoc');\nlet volt  = flow.get('IsOffgridVolt');\n\n// defaults\nif (grid === undefined) grid = false;\nif (soc === undefined) soc = false;\nif (volt === undefined) volt = false;\n\nlet handled = false;\n\nif (msg.topic === 'DI allow Offgrid') {\n    const v = Number(msg.payload);\n    if (v === 7) grid = true;\n    else grid = false;\n\n    flow.set('DiAllowOffgrid', grid);\n    handled = true; \n} else if (msg.topic === 'Soc') {\n    soc = msg.payload; \n    flow.set('IsOffgridSoc', soc);\n    handled = true;\n} else if (msg.topic === 'BatteryVoltage') {\n    volt = msg.payload; \n    flow.set('IsOffgridVolt', volt);\n    handled = true;\n}\n// return message only when known message arrive\nif (!handled) return null;\n\n// MultiPlus switch position:\n// 2 - Inverter Only, 3 - On\nconst allTrue = grid && soc && volt;\nconst outPayload = allTrue ? 2 : 3;\n\nnode.status({\n    fill: allTrue ? \"green\" : \"red\",\n    shape: \"dot\",\n    text: allTrue ? `Inverter Only` : `On`\n});\n\nreturn { topic: 'SwitchPosition', payload: outPayload };\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\ncontext.diState = context.diState || 6;\ncontext.isHighSoc = context.isHighSoc || false;",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 200,
        "wires": [
            [
                "ee1b84120e6686df",
                "04b0f61d1440b710"
            ]
        ]
